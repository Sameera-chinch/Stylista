<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/background_cream">

    <!-- ================= TOP APP BAR ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        android:background="@color/background_cream"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnListingBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:paddingStart="8dp"
            app:drawableStartCompat="@drawable/ic_arrow_back"
            app:drawableTint="@color/charcoal"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvListingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/charcoal"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:text="WESTERN" />

            <TextView
                android:id="@+id/tvListingSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:text="Showing styles" />

        </LinearLayout>

        <!-- Search Shortcut -->
        <ImageView
            android:id="@+id/btnListingSearch"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:src="@drawable/ic_search"
            app:tint="@color/charcoal"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Search"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="6dp" />

        <!-- Bag Shortcut -->
        <ImageView
            android:id="@+id/btnListingCart"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:src="@drawable/ic_shopping_bag"
            app:tint="@color/charcoal"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Shopping Bag"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- ================= FILTER & SORT ROW (Matches Mockup Screen 8) ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:orientation="horizontal">

        <!-- Filter Pill -->
        <TextView
            android:id="@+id/btnFilter"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_filter_pill"
            android:gravity="center_vertical"
            app:drawableStartCompat="@drawable/ic_filter_list"
            app:drawableTint="@color/charcoal"
            android:drawablePadding="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:text="Filter"
            android:textColor="@color/charcoal"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Sort Pill -->
        <TextView
            android:id="@+id/btnSort"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_filter_pill"
            android:gravity="center_vertical"
            app:drawableStartCompat="@drawable/ic_sort"
            app:drawableTint="@color/charcoal"
            android:drawablePadding="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:text="Sort"
            android:textColor="@color/charcoal"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Price Pill -->
        <TextView
            android:id="@+id/btnFilterPrice"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_filter_pill"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Price ∨"
            android:textColor="@color/charcoal"
            android:textSize="12sp"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Size Pill -->
        <TextView
            android:id="@+id/btnFilterSize"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_filter_pill"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Size ∨"
            android:textColor="@color/charcoal"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- ================= SUBCATEGORY PILLS ROW (Matches Mockup Screen 8) ================= -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutSubcategoryPills"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- All (Selected by default) -->
            <TextView
                android:id="@+id/pillSubcatAll"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_filter_pill_selected"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="All"
                android:textColor="@color/charcoal"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <!-- Dresses -->
            <TextView
                android:id="@+id/pillSubcatDresses"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_filter_pill"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Dresses"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginEnd="8dp" />

            <!-- Tops -->
            <TextView
                android:id="@+id/pillSubcatTops"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_filter_pill"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Tops"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginEnd="8dp" />

            <!-- Jeans / Pants -->
            <TextView
                android:id="@+id/pillSubcatJeans"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_filter_pill"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Jeans"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginEnd="8dp" />

            <!-- Co-ords -->
            <TextView
                android:id="@+id/pillSubcatCoords"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_filter_pill"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Co-ords"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginEnd="8dp" />

            <!-- Skirts -->
            <TextView
                android:id="@+id/pillSubcatSkirts"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_filter_pill"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Skirts"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- ================= 2-COLUMN PRODUCT GRID ================= -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProducts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/tvNoProducts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="No styles available in this collection"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />

    </FrameLayout>

    <!-- ================= BOTTOM NAVIGATION ================= -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/white"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_home"
                app:tint="@color/text_secondary"
                android:contentDescription="Home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCategories"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_grid_view"
                app:tint="@color/pastel_baby_blue_dark"
                android:contentDescription="Categories" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categories"
                android:textColor="@color/pastel_baby_blue_dark"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="18dp"
                android:layout_height="2dp"
                android:layout_marginTop="2dp"
                android:background="@color/pastel_baby_blue_dark" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navDiscover"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_search"
                app:tint="@color/text_secondary"
                android:contentDescription="Discover" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Discover"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navWishlist"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_favorite_border"
                app:tint="@color/text_secondary"
                android:contentDescription="Wishlist" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wishlist"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_person"
                app:tint="@color/text_secondary"
                android:contentDescription="Profile" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
