<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_offwhite">

    <!-- ==================== TOP BAR ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Discover"
            android:textColor="@color/charcoal"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/discoverSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            app:drawableStartCompat="@drawable/ic_search"
            app:drawableTint="@color/charcoal"
            android:paddingStart="8dp" />

    </LinearLayout>

    <!-- ==================== CONTENT ==================== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ==================== TRENDING ==================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trending Now"
                android:textColor="@color/charcoal"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- ==================== PRODUCT 1 ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/discoverProduct1"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_border"
                app:cardBackgroundColor="@color/card_background"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="110dp"
                        android:layout_height="120dp"
                        android:contentDescription="Trending dress"
                        android:scaleType="centerCrop"
                        android:src="@drawable/style_western" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="15dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Floral Midi Dress"
                            android:textColor="@color/charcoal"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="₹1,299"
                            android:textColor="@color/charcoal"
                            android:textStyle="bold"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="4.7 ★"
                            android:textColor="@color/forest_green"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== PRODUCT 2 ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/discoverProduct2"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_border"
                app:cardBackgroundColor="@color/card_background"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="110dp"
                        android:layout_height="120dp"
                        android:contentDescription="Trending co-ord set"
                        android:scaleType="centerCrop"
                        android:src="@drawable/style_ethnic" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="15dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Linen Co-ord Set"
                            android:textColor="@color/charcoal"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="₹1,599"
                            android:textColor="@color/charcoal"
                            android:textStyle="bold"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="4.6 ★"
                            android:textColor="@color/forest_green"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== STYLE INSPIRATION ==================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Style Inspiration"
                android:textColor="@color/charcoal"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_border"
                app:cardBackgroundColor="@color/card_background">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Style inspiration"
                    android:scaleType="centerCrop"
                    android:src="@drawable/home_banner" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOnlineProducts"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="Explore Online Products"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/btn_baby_blue_text"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/pastel_baby_blue"
                app:strokeWidth="1dp"
                app:strokeColor="@color/pastel_baby_blue_dark" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ==================== BOTTOM NAVIGATION ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@color/card_background"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- HOME -->
        <TextView
            android:id="@+id/discoverNavHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Home"
            app:drawableTopCompat="@drawable/ic_home"
            app:drawableTint="@color/text_secondary"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true" />

        <!-- CATEGORIES -->
        <TextView
            android:id="@+id/discoverNavCategories"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Categories"
            app:drawableTopCompat="@drawable/ic_grid_view"
            app:drawableTint="@color/text_secondary"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true" />

        <!-- DISCOVER -->
        <TextView
            android:id="@+id/discoverNavDiscover"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Discover"
            app:drawableTopCompat="@drawable/ic_search"
            app:drawableTint="@color/pastel_baby_blue_dark"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"
            android:textColor="@color/pastel_baby_blue_dark"
            android:textStyle="bold"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true" />

        <!-- WISHLIST -->
        <TextView
            android:id="@+id/discoverNavWishlist"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Wishlist"
            app:drawableTopCompat="@drawable/ic_favorite_border"
            app:drawableTint="@color/text_secondary"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true" />

        <!-- PROFILE -->
        <TextView
            android:id="@+id/discoverNavProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Profile"
            app:drawableTopCompat="@drawable/ic_person"
            app:drawableTint="@color/text_secondary"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
