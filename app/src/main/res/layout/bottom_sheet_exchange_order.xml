<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bottom_sheet_background">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/handle_bar" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Request Item Exchange"
        android:textColor="@color/charcoal"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Eligible within 7 days of delivery. Free replacement pickup."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Current Item Info -->
    <TextView
        android:id="@+id/tvExchangeCurrentProduct"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Item: Premium Leather Jacket"
        android:textColor="@color/charcoal"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvExchangeCurrentSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Current Size: M"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- New Size Selection -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Select New Size:"
        android:textColor="@color/charcoal"
        android:textSize="14sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="8dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupNewSizes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSizeXS"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="XS" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSizeS"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSizeM"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="M" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSizeL"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="L" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSizeXL"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="XL" />

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <!-- Reason RadioGroup -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Reason for Exchange:"
        android:textColor="@color/charcoal"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgExchangeReasons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <RadioButton
            android:id="@+id/rbExchSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current size is too small"
            android:textColor="@color/charcoal"
            android:textSize="14sp"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rbExchLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current size is too large"
            android:textColor="@color/charcoal"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbExchDefective"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Item has a defect or damage"
            android:textColor="@color/charcoal"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbExchMismatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Color or fabric not as expected"
            android:textColor="@color/charcoal"
            android:textSize="14sp" />

    </RadioGroup>

    <!-- Exchange policy note -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_category_badge"
        android:padding="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_local_shipping"
            app:tint="@color/pastel_baby_blue_dark"
            android:contentDescription="Shipping" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Our courier will bring your replacement size and pick up the original item simultaneously at zero extra cost."
            android:textColor="@color/charcoal"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnExchangeDismiss"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/button_outline_white"
            app:backgroundTint="@null"
            android:text="Dismiss"
            android:textAllCaps="false"
            android:textColor="@color/charcoal"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSubmitExchange"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/button_blue"
            app:backgroundTint="@null"
            android:text="Submit Request"
            android:textAllCaps="false"
            android:textColor="@color/btn_baby_blue_text"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
