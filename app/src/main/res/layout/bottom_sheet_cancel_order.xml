<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bottom_sheet_background">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/handle_bar" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cancel Order"
        android:textColor="@color/charcoal"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCancelSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Please let us know why you are cancelling this order:"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Honest refund info box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_category_badge"
        android:padding="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_info_circle"
            app:tint="@color/pastel_baby_blue_dark"
            android:contentDescription="Info" />

        <TextView
            android:id="@+id/tvCancelRefundNotice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Nothing was charged for this order. No payment deduction occurred."
            android:textColor="@color/charcoal"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Reasons RadioGroup -->
    <RadioGroup
        android:id="@+id/rgCancelReasons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">

        <RadioButton
            android:id="@+id/rbReasonMistake"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ordered by mistake"
            android:textColor="@color/charcoal"
            android:textSize="14sp"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rbReasonPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Found a better price elsewhere"
            android:textColor="@color/charcoal"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbReasonDelivery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estimated delivery time is too long"
            android:textColor="@color/charcoal"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbReasonOther"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Other reason"
            android:textColor="@color/charcoal"
            android:textSize="14sp" />

    </RadioGroup>

    <!-- Optional Comment -->
    <EditText
        android:id="@+id/etCancelNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Additional details (optional)..."
        android:background="@drawable/bg_search_box"
        android:padding="12dp"
        android:textColor="@color/charcoal"
        android:textColorHint="@color/text_hint"
        android:textSize="13sp"
        android:visibility="gone"
        android:maxLines="3" />

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelDismiss"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/button_outline_white"
            app:backgroundTint="@null"
            android:text="Keep Order"
            android:textAllCaps="false"
            android:textColor="@color/charcoal"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnConfirmCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/button_blue"
            app:backgroundTint="@null"
            android:text="Confirm Cancel"
            android:textAllCaps="false"
            android:textColor="@color/error_red"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
