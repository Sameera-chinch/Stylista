<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_cream">

    <!-- TOP APP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/white"
        android:elevation="2dp">

        <TextView
            android:id="@+id/btnWishlistBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:paddingStart="10dp"
            app:drawableStartCompat="@drawable/ic_arrow_back"
            app:drawableTint="@color/charcoal"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvWishlistTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="My Wishlist"
            android:textColor="@color/charcoal"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnWishlistEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Edit"
            android:textColor="@color/pastel_baby_blue_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- WISHLIST SCROLLABLE CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="96dp">

        <LinearLayout
            android:id="@+id/wishlistContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Dynamic content loaded via WishlistActivity -->

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM NAVIGATION (Stylista Design Token Navigation) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/white"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wishlistNavHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Home"
            app:drawableTopCompat="@drawable/ic_home"
            app:drawableTint="@color/text_secondary"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/wishlistNavCategories"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Categories"
            app:drawableTopCompat="@drawable/ic_grid_view"
            app:drawableTint="@color/text_secondary"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/wishlistNavDiscover"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Discover"
            app:drawableTopCompat="@drawable/ic_search"
            app:drawableTint="@color/text_secondary"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/wishlistNavWishlist"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Wishlist"
            app:drawableTopCompat="@drawable/ic_favorite_filled"
            app:drawableTint="@color/pastel_baby_blue_dark"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"
            android:textColor="@color/pastel_baby_blue_dark"
            android:textStyle="bold"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/wishlistNavProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Profile"
            app:drawableTopCompat="@drawable/ic_person"
            app:drawableTint="@color/text_secondary"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
