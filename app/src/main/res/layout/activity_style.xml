<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_offwhite"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="48dp">

        <!-- Top Navigation Bar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="start|center_vertical"
                android:gravity="center"
                android:paddingStart="8dp"
                app:drawableStartCompat="@drawable/ic_arrow_back"
                app:drawableTint="@color/charcoal"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnSkipTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:text="Skip"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true" />

        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tvStyleTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Your Style Preferences"
            android:textColor="@color/charcoal"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="serif" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvStyleSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Select what you love. We'll tailor your recommendations."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- SECTION 1: CATEGORIES -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="FAVORITE CATEGORIES"
            android:textColor="@color/pastel_baby_blue_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- ROW 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- Western -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWestern"
                android:layout_width="0dp"
                android:layout_height="135dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/card_border"
                app:cardBackgroundColor="@color/card_background"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="75dp"
                        android:contentDescription="Western"
                        android:scaleType="centerCrop"
                        android:src="@drawable/style_western" />

                    <TextView
                        android:id="@+id/tvWestern"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Western"
                        android:textColor="@color/charcoal"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Ethnic -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEthnic"
                android:layout_width="0dp"
                android:layout_height="135dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/card_border"
                app:cardBackgroundColor="@color/card_background"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="75dp"
                        android:contentDescription="Ethnic"
                        android:scaleType="centerCrop"
                        android:src="@drawable/style_ethnic" />

                    <TextView
                        android:id="@+id/tvEthnic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Ethnic"
                        android:textColor="@color/charcoal"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Sports -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSports"
                android:layout_width="0dp"
                android:layout_height="135dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/card_border"
                app:cardBackgroundColor="@color/card_background"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="75dp"
                        android:contentDescription="Sports"
                        android:scaleType="centerCrop"
                        android:src="@drawable/style_sports" />

                    <TextView
                        android:id="@+id/tvSports"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Sports"
                        android:textColor="@color/charcoal"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- ROW 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <!-- Maternity -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMaternity"
                android:layout_width="0dp"
                android:layout_height="135dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/card_border"
                app:cardBackgroundColor="@color/card_background"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="75dp"
                        android:contentDescription="Maternity"
                        android:scaleType="centerCrop"
                        android:src="@drawable/style_maternity" />

                    <TextView
                        android:id="@+id/tvMaternity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Maternity"
                        android:textColor="@color/charcoal"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Formal -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFormal"
                android:layout_width="0dp"
                android:layout_height="135dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/card_border"
                app:cardBackgroundColor="@color/card_background"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="75dp"
                        android:contentDescription="Formal"
                        android:scaleType="centerCrop"
                        android:src="@drawable/style_formal" />

                    <TextView
                        android:id="@+id/tvFormal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Formal"
                        android:textColor="@color/charcoal"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Accessories -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAccessories"
                android:layout_width="0dp"
                android:layout_height="135dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/card_border"
                app:cardBackgroundColor="@color/card_background"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="75dp"
                        android:contentDescription="Accessories"
                        android:scaleType="centerCrop"
                        android:src="@drawable/style_accessories" />

                    <TextView
                        android:id="@+id/tvAccessories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Accessories"
                        android:textColor="@color/charcoal"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- SECTION 2: SIZES -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="PREFERRED SIZES"
            android:textColor="@color/pastel_baby_blue_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Multi-select sizes you frequently wear"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupSizes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="4dp" />

        <!-- SECTION 3: BUDGET RANGE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BUDGET PER ITEM"
                android:textColor="@color/pastel_baby_blue_dark"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvBudgetValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹499 – ₹3,299"
                android:textColor="@color/charcoal"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <com.google.android.material.slider.RangeSlider
            android:id="@+id/sliderBudget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:valueFrom="499"
            android:valueTo="3299"
            android:stepSize="100"
            app:thumbColor="@color/pastel_baby_blue_dark"
            app:trackColorActive="@color/pastel_baby_blue"
            app:trackColorInactive="@color/card_border" />

        <!-- ACTIONS -->
        <Button
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/button_blue"
            app:backgroundTint="@null"
            android:text="Save Style Preferences"
            android:textAllCaps="false"
            android:textColor="@color/btn_baby_blue_text"
            android:textStyle="bold"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnSkip"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackground"
            app:backgroundTint="@null"
            android:text="Skip for now"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
