<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_border"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- 3:4 Portrait Thumbnail Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="88dp"
            android:layout_height="116dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivWishlistImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Product image"
                android:src="@drawable/ic_placeholder_product" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Product Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvWishlistCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WESTERN"
                android:textColor="@color/pastel_baby_blue_dark"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvWishlistName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Product Name"
                android:textColor="@color/charcoal"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvWishlistPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="₹1,299"
                android:textColor="@color/charcoal"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Action Buttons (Heart and Add to Bag) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnWishlistHeart"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/social_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="9dp"
                app:drawableStartCompat="@drawable/ic_favorite_filled"
                app:drawableTint="@color/error_red" />

            <TextView
                android:id="@+id/btnWishlistAddBag"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/button_butter_yellow"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="9dp"
                app:drawableStartCompat="@drawable/ic_shopping_bag"
                app:drawableTint="@color/btn_butter_yellow_text" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
