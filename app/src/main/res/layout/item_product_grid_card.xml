<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_border"
    app:cardBackgroundColor="@color/white"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 3:4 Portrait Image Container with Heart Button Overlay -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/warm_white">

            <ImageView
                android:id="@+id/gridProductImage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                android:contentDescription="Product Image"
                android:src="@drawable/ic_placeholder_product"
                app:layout_constraintDimensionRatio="3:4"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Wishlist Toggle Heart (Matches Mockup) -->
            <TextView
                android:id="@+id/btnGridWishlist"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_bottom_sheet_card"
                android:gravity="center"
                android:paddingStart="5dp"
                app:drawableStartCompat="@drawable/ic_favorite_border"
                app:drawableTint="@color/charcoal"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Product Details Container (Uniform Height for Perfect Alignment) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <!-- Category Tag -->
            <TextView
                android:id="@+id/tvGridCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WESTERN"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <!-- Title with Fixed 2 Lines for Alignment -->
            <TextView
                android:id="@+id/tvGridName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:lines="2"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="Ditsy Floral Dress"
                android:textColor="@color/charcoal"
                android:textSize="13sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp" />

            <!-- Price and Size Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvGridPrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="₹1,299"
                    android:textColor="@color/charcoal"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGridSizes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_size_chip_unselected"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="XS - XL"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
