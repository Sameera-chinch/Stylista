<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Stylista" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/butter_yellow</item>
        <item name="colorOnPrimary">@color/charcoal</item>
        <item name="colorPrimaryContainer">@color/butter_yellow_light</item>
        <item name="colorOnPrimaryContainer">@color/charcoal</item>

        <item name="colorSecondary">@color/pastel_baby_blue</item>
        <item name="colorOnSecondary">@color/charcoal</item>
        <item name="colorSecondaryContainer">@color/pastel_baby_blue_light</item>
        <item name="colorOnSecondaryContainer">@color/charcoal</item>

        <!-- Surfaces & Backgrounds -->
        <item name="android:colorBackground">@color/background_cream</item>
        <item name="colorSurface">@color/warm_white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/neutral_light</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/card_border</item>

        <!-- Status & Navigation Bars -->
        <item name="android:statusBarColor">@color/background_cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/warm_white</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Dialog & Bottom Sheet Style -->
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Stylista.BottomSheetDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Stylista.MaterialAlertDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Stylista.MaterialAlertDialog</item>
    </style>

    <style name="Theme.Stylista" parent="Base.Theme.Stylista" />

    <style name="ThemeOverlay.Stylista.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/charcoal</item>
        <item name="colorOnSurface">@color/charcoal</item>
    </style>

    <style name="ThemeOverlay.Stylista.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Stylista.BottomSheet.Modal</item>
    </style>

    <style name="Widget.Stylista.BottomSheet.Modal" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/warm_white</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Stylista.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.Stylista.BottomSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
